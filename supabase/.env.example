# Copy to `supabase/.env` (gitignored). Loaded by `supabase start` for GoTrue [auth.external.google].
# Values come from Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
#
# Do NOT use the SUPABASE_ prefix for these — the CLI skips env names that start with SUPABASE_.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
