# Copy to `.env.local` for local development (Next.js loads it automatically; gitignored).
# cp .env.example .env.local

# App — must match how you run the dev server (scheme + host + port).
# HTTPS local: `bun run dev` (Next.js `--experimental-https`) → https://localhost:3000
# Plain HTTP: `bun run dev:http` → http://localhost:3000
NEXT_PUBLIC_APP_URL=https://localhost:3000
NEXT_PUBLIC_NOINDEX=false

# Supabase
# Local CLI: run `supabase start` in this repo, then `supabase status -o env` and map:
#   NEXT_PUBLIC_SUPABASE_URL  <- API_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  <- ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY  <- SERVICE_ROLE_KEY
# (This project uses API port 55421 by default so it can run beside another stack on 54321.)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe (chicken checkout — server-only; get keys from https://dashboard.stripe.com )
STRIPE_SECRET_KEY=

# OAuth redirect: add https://localhost:3000/auth/callback (and production URL) in
# Supabase Auth → URL configuration when using local HTTPS.
#
# Google OAuth + One Tap: same OAuth Web client as GoTrue. Public client ID for the Next.js app:
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
#
# Also set the client ID + secret in `supabase/.env` as GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# (see `supabase/.env.example`). Self-hosted Supabase reads those for GoTrue.
# https://supabase.com/docs/guides/auth/social-login/auth-google
